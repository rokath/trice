# -----------------------------------------------------------------------------
# IntelliJ / CLion project files (.idea)
#
# Goal:
# - Keep only stable, shareable project metadata in Git.
# - Ignore user-specific / machine-specific state (workspace, tasks, shelves, ...).
# - Allow a shared spelling dictionary for the project.
# -----------------------------------------------------------------------------

# --- User-specific IDE state (never commit) -----------------------------------
# Window layout, opened files, run/debug selections, etc.
/workspace.xml
# Task management state.
/tasks.xml
# IDE usage statistics.
/usage.statistics.xml
# Shelved changes can contain personal patches.
/shelf/

# --- Project metadata (OK to commit) ------------------------------------------
# Keep misc.xml, modules.xml, trice.iml and vcs.xml versioned.

# --- Shared spelling dictionary (commit this) ---------------------------------
# Keep dictionaries/project.xml versioned; it uses JetBrains XML format.
/dictionaries/*
!/dictionaries/project.xml

# --- Optional: ignore caches and transient folders ----------------------------
/caches/
/libraries/
/artifacts/
